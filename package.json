{
  "name": "@mirsella/opencode-browser-mcp",
  "version": "0.9.2",
  "description": "Session-isolated browser automation over MCP and Chrome DevTools Protocol",
  "type": "module",
  "exports": {
    "./server": "./plugin/browser-routing.ts"
  },
  "bin": {
    "browser-mcp": "vendor/browser-mcp"
  },
  "files": [
    "plugin/",
    "skills/",
    "vendor/",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "hooks/",
    ".agents/plugins/marketplace.json",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build:native": "cargo build --release --target x86_64-unknown-linux-musl",
    "stage:native": "node scripts/stage-native.mjs",
    "prepack": "cargo build --release --target x86_64-unknown-linux-musl && node scripts/stage-native.mjs",
    "test": "cargo test --all-targets && bun test tests/plugin.test.ts"
  },
  "keywords": [
    "opencode",
    "mcp",
    "browser",
    "browser-automation",
    "cdp",
    "session-isolation",
    "chrome-devtools",
    "chromium",
    "codex"
  ],
  "homepage": "https://github.com/mirsella/browser-mcp#readme",
  "bugs": "https://github.com/mirsella/browser-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirsella/browser-mcp.git"
  },
  "license": "MIT",
  "author": "mirsella",
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "opencode": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
